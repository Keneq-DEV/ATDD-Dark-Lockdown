  <library_effects>
    <effect id="cable_black-effect">
      <profile_COMMON>
        <newparam sid="cable_black_jpg-surface">
          <surface type="2D">
            <init_from>cable_black_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="cable_black_jpg-sampler">
          <sampler2D>
            <source>cable_black_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="cable_black_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
